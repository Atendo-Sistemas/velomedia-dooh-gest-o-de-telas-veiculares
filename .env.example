# VeloMedia DOOH production environment template.
# Generate WEBHOOK_SECRET with: openssl rand -hex 32
NODE_ENV="production"
HOST="127.0.0.1"
PORT="3000"
APP_HOST_PORT="3300"
TRUST_PROXY="true"
WEBHOOK_SECRET=""
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_NAME="Administrador"
INITIAL_ORGANIZATION_NAME="VeloMedia"
DATA_FILE_PATH="/var/lib/velomedia/velomedia_store.json"
CORS_ALLOWED_ORIGINS="https://app.example.com"

# Optional integrations and simulation flags
SIMULATION_ENABLED="false"
ENABLE_DEV_PAYMENT_SIMULATION="false"
MAPBOX_ACCESS_TOKEN=""
