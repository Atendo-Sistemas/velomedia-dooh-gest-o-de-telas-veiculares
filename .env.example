# Modelo de variáveis de ambiente para produção do VeloMedia DOOH.
# Gere WEBHOOK_SECRET com: openssl rand -hex 32
# Gere senhas com: openssl rand -base64 24
NODE_ENV="production"
HOST="127.0.0.1"
PORT="3000"
APP_HOST_PORT="3300"
TRUST_PROXY="true"
WEBHOOK_SECRET=""
POSTGRES_DB="velomedia"
POSTGRES_USER="velomedia_admin"
POSTGRES_PASSWORD=""
POSTGRES_APP_USER="velomedia_app"
POSTGRES_APP_PASSWORD=""
# Para banco gerenciado separadamente/systemd, defina DATABASE_URL.
DATABASE_URL=""
PG_POOL_MAX="10"
PGSSL="false"
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_NAME="Administrador"
INITIAL_ORGANIZATION_NAME="VeloMedia"
CORS_ALLOWED_ORIGINS="https://app.example.com"

# Integrações opcionais e sinalizadores de simulação
SIMULATION_ENABLED="false"
MAPBOX_ACCESS_TOKEN=""

# Pagamentos PIX.
# disabled = modo de demonstração: nenhuma cobrança é gerada e nenhum pagamento é confirmado.
# asaas    = exige ASAAS_API_KEY e ASAAS_WEBHOOK_TOKEN (gere o token com: openssl rand -hex 32).
# mock_dev/efi_bank/mercadopago são rejeitados em produção. URL do webhook: /api/v1/webhooks/asaas
PIX_GATEWAY_PROVIDER="disabled"
ASAAS_ENVIRONMENT="sandbox"
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""
