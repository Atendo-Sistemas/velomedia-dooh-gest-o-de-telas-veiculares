# ============================================================================
# VeloMedia DOOH — Environment Variables Configuration
# ============================================================================

# Gemini AI API Key (Injected by AI Studio)
GEMINI_API_KEY=""

# Application Base URL (e.g., https://my-app.run.app)
APP_URL=""

# Production Cryptographic Secrets (MUST be unique, random 64-char strings in production)
SESSION_SECRET=""
DEVICE_HMAC_MASTER_SECRET=""
WEBHOOK_SECRET=""

# Initial Admin Bootstrap Password (required in production on initial setup)
INITIAL_ADMIN_PASSWORD=""

# Production PostgreSQL Database (e.g., postgresql://user:pass@host:5432/velomedia_prod)
DATABASE_URL=""

# Allowed CORS Origins (Comma-separated list, e.g., https://app.velomedia.com.br,https://admin.velomedia.com.br)
CORS_ALLOWED_ORIGINS=""

# PIX Payment Gateway Configuration (e.g., efi_bank, mercadopago, asaas)
PIX_GATEWAY_PROVIDER="efi_bank"
PIX_CLIENT_ID=""
PIX_CLIENT_SECRET=""
PIX_KEY=""

# Security and Simulation Flags (Strictly false in production)
SIMULATION_ENABLED="false"
ENABLE_DEV_PAYMENT_SIMULATION="false"

# Mapbox Access Token for Geofence & Fleet Vector Maps
MAPBOX_ACCESS_TOKEN=""
