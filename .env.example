# Modelo de variáveis de ambiente para produção do VeloMedia DOOH.
NODE_ENV="production"
HOST="127.0.0.1"
PORT="3000"
APP_HOST_PORT="3300"
TRUST_PROXY="true"
POSTGRES_DB="velomedia"
POSTGRES_USER="velomedia_admin"
POSTGRES_PASSWORD=""
POSTGRES_APP_USER="velomedia_app"
POSTGRES_APP_PASSWORD=""
# Para banco gerenciado separadamente/systemd, defina DATABASE_URL.
DATABASE_URL=""
PG_POOL_MAX="10"
PGSSL="false"
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_NAME="Administrador"
INITIAL_ORGANIZATION_NAME="VeloMedia"
CORS_ALLOWED_ORIGINS="https://app.example.com"

# Tokens e APIs (Asaas, Mapbox, segredo de webhook) NÃO são necessários na instalação.
# Configure-os após o primeiro login em Configurações > Integrações.
# As variáveis abaixo continuam aceitas apenas como alternativa opcional.
SIMULATION_ENABLED="false"
