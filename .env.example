# VeloMedia DOOH production environment template.
# Generate WEBHOOK_SECRET with: openssl rand -hex 32
NODE_ENV="production"
HOST="127.0.0.1"
PORT="3000"
APP_HOST_PORT="3300"
TRUST_PROXY="true"
WEBHOOK_SECRET=""
POSTGRES_DB="velomedia"
POSTGRES_USER="velomedia_admin"
POSTGRES_PASSWORD=""
POSTGRES_APP_USER="velomedia_app"
POSTGRES_APP_PASSWORD=""
# For a separately managed database/systemd, set DATABASE_URL instead.
DATABASE_URL=""
PG_POOL_MAX="10"
PGSSL="false"
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_NAME="Administrador"
INITIAL_ORGANIZATION_NAME="VeloMedia"
CORS_ALLOWED_ORIGINS="https://app.example.com"

# Optional integrations and simulation flags
SIMULATION_ENABLED="false"
ENABLE_DEV_PAYMENT_SIMULATION="false"
MAPBOX_ACCESS_TOKEN=""
