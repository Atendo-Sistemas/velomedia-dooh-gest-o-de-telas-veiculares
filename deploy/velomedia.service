[Unit]
Description=VeloMedia DOOH application
After=network.target

[Service]
Type=simple
User=velomedia
Group=velomedia
WorkingDirectory=/opt/velomedia
EnvironmentFile=/etc/velomedia/velomedia.env
ExecStart=/usr/bin/node /opt/velomedia/dist/server.cjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/velomedia
UMask=0077

[Install]
WantedBy=multi-user.target
